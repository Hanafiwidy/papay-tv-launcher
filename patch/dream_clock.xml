<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream and Home's idle clock): Home's wallpaper behind a large thin clock, the
     greeting, the date, and a liquid-glass card with Jakarta's weather now and tomorrow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dream_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="96dp"
        android:paddingEnd="96dp"
        android:paddingTop="64dp"
        android:paddingBottom="64dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/dreamGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.24"
                android:shadowColor="#B3000000"
                android:shadowRadius="10"
                android:shadowDx="0"
                android:shadowDy="2"
                android:textAllCaps="true" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="150sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.05"
                android:shadowColor="#99000000"
                android:shadowRadius="18"
                android:shadowDx="0"
                android:shadowDy="3"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginTop="8dp"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#D9FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.16"
                android:shadowColor="#B3000000"
                android:shadowRadius="10"
                android:shadowDx="0"
                android:shadowDy="2"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:orientation="vertical"
            android:gravity="start"
            android:background="@drawable/weather_card"
            android:paddingStart="26dp"
            android:paddingEnd="30dp"
            android:paddingTop="22dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/dreamLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.26"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/dreamTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="54sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/dreamCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@string/font_regular" />

            <TextView
                android:id="@+id/dreamAqi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:textSize="13sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.04" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#26FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="BESOK"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.24"
                android:textAllCaps="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/dreamTomorrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#E6FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="@string/font_light" />

                <TextView
                    android:id="@+id/dreamTomorrowRain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:singleLine="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@string/font_regular" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
