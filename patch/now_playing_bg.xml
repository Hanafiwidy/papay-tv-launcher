<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card behind the now-playing panel: the pills' frosted look, larger corners, brighter rim on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#5CFFFFFF" android:endColor="#29FFFFFF" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
