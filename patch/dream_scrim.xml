<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver: a soft darkening from the left edge over the wallpaper, so the thin clock, the date
     and the greeting stay readable over bright pictures without hiding the wallpaper itself. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#B3000000"
        android:centerColor="#4D000000"
        android:endColor="#00000000" />
</shape>
